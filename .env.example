# =============================================================================
# Configuracion del Simulador de Bolsa (PRAC1) - EJEMPLO
# Copia este fichero a ".env" y ajusta los valores. NO subas el .env al repo.
# Las variables se leen desde el entorno (os.environ); no se requiere
# dependencia externa (como python-dotenv). Para cargarlas desde este fichero
# en sistemas tipo Unix:   set -a; source .env; set +a
# En Windows PowerShell:  Get-Content .env | ForEach-Object { ... }
# =============================================================================

# Semilla del generador aleatorio. Con la misma semilla la simulacion es
# reproducible (util para depurar y para tests).
SIMULADOR_SEMILLA=42

# Numero de sesiones (dias de mercado) que se simulan en el modo --demo.
SIMULADOR_SESIONES=30

# Efectivo inicial de la cartera, en euros.
SIMULADOR_EFECTIVO_INICIAL=10000.0

# Lista de tickers separados por coma que poblaran el mercado en el demo.
SIMULADOR_TICKERS=ACME,GLOB,OILX,TECH,BONO10
